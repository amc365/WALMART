WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
# Ads (Walmart Connect) — add later
# NOTE: the ads integration is not built yet — setting these does not enable it.
WALMART_ADS_API_KEY=
WALMART_ADVERTISER_ID=
PORT=3000

# Optional tuning (defaults shown)
# Safety ceiling on listing pagination (200 items per page). Raise if the
# dashboard warns that the listing list is incomplete.
# WALMART_MAX_ITEM_PAGES=500
# Max per-SKU inventory lookups when the bulk inventory report is unavailable.
# SKUs beyond this are reported as unverified, never assumed healthy.
# WALMART_PER_SKU_INVENTORY_LIMIT=500
# Where approval queues are stored. On Render, point this at a Persistent Disk
# mount path to keep approval history across redeploys.
# DATA_DIR=./data
# Validate and record promotions without sending them to Walmart.
# PROMOTIONS_DRY_RUN=true
